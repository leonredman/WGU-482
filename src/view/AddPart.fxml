<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="538.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.AddPartViewController">
   <children>
<!--      <Button fx:id="secondButton" layoutX="29.0" layoutY="472.0" mnemonicParsing="false" onAction="#toMain" prefHeight="52.0" prefWidth="194.0" text="To The Main Scene" />-->
      <AnchorPane fx:id="inHouse" layoutX="29.0" layoutY="21.0" prefHeight="38.0" prefWidth="542.0">
         <children>
            <Label layoutX="37.0" layoutY="21.0" prefHeight="30.0" prefWidth="62.0" text="Add Part">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            <RadioButton fx:id="addPartInHouseYes" layoutX="139.0" layoutY="27.0" mnemonicParsing="false" onAction="#onFirst" selected="true" text="In-House">
               <toggleGroup>
                  <ToggleGroup fx:id="tGroup" />
               </toggleGroup></RadioButton>
            <RadioButton fx:id="addPartOutsourcedYes" layoutX="296.0" layoutY="27.0" mnemonicParsing="false" onAction="#onSecond" text="Outsourced" toggleGroup="$tGroup" />
         </children>
      </AnchorPane>
      <AnchorPane layoutX="59.0" layoutY="78.0" prefHeight="314.0" prefWidth="473.0">
         <children>
            <Label layoutX="48.0" layoutY="51.0" text="ID" />
            <TextField fx:id="partIdTxt" disable="true" layoutX="121.0" layoutY="47.0" promptText="Auto Gen-Disabled">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets></TextField>
            <Label layoutX="39.0" layoutY="95.0" text="Name" />
            <TextField fx:id="partNameTxt" layoutX="121.0" layoutY="91.0" promptText="Part Name" />
            <Label layoutX="39.0" layoutY="137.0" text="Inv" />
            <TextField fx:id="partStockTxt" layoutX="121.0" layoutY="133.0" promptText="100" />
            <Label layoutX="33.0" layoutY="182.0" text="Price/Cost" />
            <TextField fx:id="partPriceTxt" layoutX="121.0" layoutY="178.0" promptText="12.99" />
            <Label layoutX="33.0" layoutY="225.0" text="Max" />
            <TextField fx:id="partInventoryMaxTxt" layoutX="121.0" layoutY="221.0" promptText="100" />
            <Label layoutX="296.0" layoutY="225.0" text="Min" />
            <TextField fx:id="partInventoryMinTxt" layoutX="323.0" layoutY="221.0" prefHeight="25.0" prefWidth="142.0" promptText="1" />
            <Label fx:id="addChangeMe" layoutX="30.0" layoutY="266.0" text="Machine ID" />
            <TextField fx:id="partToggleIdTxt" layoutX="121.0" layoutY="262.0" />


         </children>
      </AnchorPane>
      <AnchorPane layoutX="122.0" layoutY="393.0" prefHeight="41.0" prefWidth="410.0">
         <children>
            <Button fx:id="savePartBtn" layoutX="232.0" layoutY="8.0" mnemonicParsing="false" onAction="#onActionSavePart" text="Save" />
            <Button fx:id="secondButton" layoutX="327.0" layoutY="8.0" mnemonicParsing="false" onAction="#toMain" text="Cancel" />
<!--            <Button layoutX="327.0" layoutY="8.0" mnemonicParsing="false" text="Cancel" />-->
<!--             <Button fx:id="secondButton" layoutX="29.0" layoutY="472.0" mnemonicParsing="false" onAction="#toMain" prefHeight="52.0" prefWidth="194.0" text="To The Main Scene" />-->
         </children>
      </AnchorPane>

   </children>
</AnchorPane>
